  "course_outline": {
    "title": "电场强度的定义",
    "audience": "已学过库仑定律和力的方向的学生",
    "main_question": "怎样用试探电荷描述某一点的电场？",
    "target_minutes": 1.25,
    "prior_knowledge": [
      {
        "id": "coulomb-law",
        "description": "距离和源电荷固定时，电场力随试探电荷量改变。"
      }
    ],
    "objectives": [
      {
        "id": "field-direction",
        "outcome": "能定义电场强度，并据电荷正负判断受力方向。"
      }
    ],
